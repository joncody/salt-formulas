// ==============================================================================
// Zellij System Configuration (/etc/zellij/config.kdl)
// ==============================================================================

// Shell & Editor
default_shell "nu"
scrollback_editor "hx"

// UI & Theme (Gruvbox Light Workstation)
theme "gruvbox-light"
simplified_ui true
pane_frames false

// Layouts: System layout directory and default layout
layout_dir "/etc/zellij/layouts"
default_layout "default"

// Behavior
copy_on_select true
